# Key Google Maps (opsional tapi disarankan).
# Tanpa key, aplikasi tetap jalan memakai OSRM + Nominatim (jarak nyata di jalan,
# bukan garis lurus) dan peta OpenStreetMap.
#
# Kalau diisi, aktifkan di Google Cloud Console:
#   - Maps JavaScript API  (tidak wajib, peta tetap pakai Leaflet)
#   - Places API
#   - Directions API
#   - Distance Matrix API
VITE_GOOGLE_MAPS_API_KEY=

# Opsional: ganti endpoint kalau mau pakai server OSRM/Nominatim sendiri.
VITE_OSRM_BASE_URL=https://router.project-osrm.org
VITE_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Nama aplikasi (dipakai di judul tab & header)
VITE_APP_NAME=Rute Ojol
