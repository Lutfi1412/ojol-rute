# Salin file ini menjadi .env lalu isi key yang kamu punya.
# Semua opsional: tanpa key pun aplikasi jalan (Photon + OSRM + tile CARTO).

# 1) Google Maps Platform — Places API + Distance Matrix API + Directions API
#    https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=

# 2) LocationIQ — autocomplete alamat, gratis 5.000 request/hari
#    https://locationiq.com/
VITE_LOCATIONIQ_KEY=

# 3) MapTiler — satu key untuk tile peta + geocoding, gratis 100.000/bulan
#    https://cloud.maptiler.com/
VITE_MAPTILER_KEY=

# Opsional: override tile peta manual (dipakai kalau VITE_MAPTILER_KEY kosong)
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# Server routing OSRM (jarak & polyline kalau tanpa Google)
VITE_OSRM_BASE_URL=https://router.project-osrm.org

# Server pencarian OSM (cadangan otomatis kalau provider berkey gagal)
VITE_PHOTON_BASE_URL=https://photon.komoot.io
VITE_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Nama aplikasi di judul tab & header
VITE_APP_NAME=Rute Ojol
